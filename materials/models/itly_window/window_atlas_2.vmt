"VertexlitGeneric"
{
    "$color" "[1 1 1]"
    "$additive" 1
	"$basetexture" "models/itly_window/window_atlas_1_diff"
	"$bumpmap" "models/itly_window/window_atlas_1_nrm"
	"$envmapmask" "models/itly_window/window_atlas_1_envmap"
	"$envmap" "env_cubemap"
    "$phong" "1"
    "$phongboost" "1"
    "$phongfresnelranges" "[10 0.5 1]"

    // Optional: si tu veux activer la lumière dynamique + ombrage
    "$model" "1"
}
